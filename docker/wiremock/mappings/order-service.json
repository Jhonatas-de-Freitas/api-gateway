        },
        "bodyFileName": "orders/created.json"
      }
    },
    {
      "name": "order-service: list orders",
      "request": {
        "method": "GET",
        "urlPathPattern": "/orders/?"
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "bodyFileName": "orders/page.json"
      }
    },
    {
      "name": "order-service: order by id",
      "request": {
        "method": "GET",
        "urlPath": "/orders/7c1f0a34-5b1d-4f6e-8a2b-9d3e4f5a6b7c"
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "bodyFileName": "orders/order.json"
      }
    },
    {
      "name": "order-service: order updates, one event every 2 s",
      "request": {
        "method": "GET",
