{
  "mappings": [
    {
      "name": "order-service: create order",
      "request": {
        "method": "POST",
        "urlPathPattern": "/orders/?"
      },
      "response": {
        "status": 202,
        "headers": {
          "Content-Type": "application/json",
          "Location": "/orders/7c1f0a34-5b1d-4f6e-8a2b-9d3e4f5a6b7c"
        },
        "bodyFileName": "orders/created.json"
      }
    },
    {
      "name": "order-service: list orders",
      "request": {
        "method": "GET",
        "urlPathPattern": "/orders/?"
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "bodyFileName": "orders/page.json"
      }
    },
    {
      "name": "order-service: order by id (the ones in the list and in the stream)",
      "request": {
        "method": "GET",
        "urlPathPattern": "/orders/(7c1f0a34-5b1d-4f6e-8a2b-9d3e4f5a6b7c|9a2b6f10-3c4d-4e5f-8a6b-7c8d9e0f1a2b|c4d5e6f7-1a2b-4c3d-9e8f-0a1b2c3d4e5f|e6f7a8b9-2c3d-4e4f-8a9b-1c2d3e4f5a6b)"
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "bodyFileName": "orders/{{request.pathSegments.[1]}}.json",
        "transformers": [
          "response-template"
        ]
      }
    },
    {
      "name": "order-service: order updates, one event every 2 s",
      "request": {
        "method": "GET",
        "urlPath": "/orders/stream"
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "text/event-stream",
          "Cache-Control": "no-cache"
        },
        "bodyFileName": "orders/stream.txt",
        "chunkedDribbleDelay": {
          "numberOfChunks": 3,
          "totalDuration": 6000
        }
      }
    }
  ]
}
